# URL absoluta da API. Obrigatória no build do app Capacitor: não existe
# proxy do Vite lá, e o default relativo (/api) resolveria para o próprio
# WebView (capacitor://localhost/api) em vez do servidor.
VITE_API_URL=https://mob-api.brimes.net/api

# Usado só pelo dev server (npm run dev), que faz proxy de /api para cá.
VITE_PROXY_TARGET=http://localhost:8080

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
