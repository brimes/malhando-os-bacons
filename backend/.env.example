PORT=8080
DATABASE_URL=postgres://mob_user:mob_password@localhost:5432/mob_db?sslmode=disable
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost

# Assistant provider: gemini (default) or opencode
ASSISTANT_PROVIDER=gemini

# Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Only used when ASSISTANT_PROVIDER=opencode
OPENCODE_URL=http://localhost:4096
OPENCODE_MODEL=openai/gpt-5.6-sol

# Autenticação (todas opcionais; sem elas o recurso responde 503 e o resto funciona)
# Redefinição de senha por e-mail (https://brevo.com). O remetente precisa ser validado no Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=mob@zel.care
BREVO_SENDER_NAME=Malhando os Bacons
# Client IDs OAuth do Google aceitos como `aud` (web, iOS e Android), separados por vírgula.
GOOGLE_CLIENT_IDS=
# Sign in with Apple. TEAM_ID/KEY_ID/PRIVATE_KEY (conteúdo do .p8) só servem para revogar o vínculo ao excluir a conta.
APPLE_BUNDLE_ID=net.brimes.mob
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
